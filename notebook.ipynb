        ],
        "source": [
            "total_papers = sum(len(papers) for papers in data.values())\n",
            "section_freq: Dict[str, int] = {}\n",
            "for papers in data.values():\n",
            "    for p in papers.values():\n",
            "        for s in p[\"sections\"].keys():\n",
            "            section_freq[s] = section_freq.get(s, 0) + 1\n",
            "\n",
            "print(\"Section Coverage Across Dataset:\")\n",
            "for sec, count in sorted(section_freq.items(), key=lambda x: x[1], reverse=True)[:12]:\n",
            "    pct = count / total_papers * 100\n",
            "    print(f\"  {sec:<24} : {count:>4}/{total_papers} ({pct:>5.1f}%)\")"
        ]
    },
